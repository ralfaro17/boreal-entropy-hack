{
	"name": "Boreal Entropy Monorepo devcontainer",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/boreal-entropy",

	"postCreateCommand": "cd /workspaces/boreal-entropy/.devcontainer && bash ./setup.sh",

	"containerEnv": {
		"UV_CACHE_DIR": "/workspaces/boreal-entropy/uv/cache"
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {  
		"ghcr.io/devcontainers/features/node:2": {
			"nodeGypDependencies": true,
			"version": "lts",
			"npmVersion": "none",
			"pnpmVersion": "latest",
			"nvmVersion": "latest"
		},
		"ghcr.io/devcontainers-extra/features/uv:1": {}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [
		5432, // PostgreSQL database port
		1025, // Mailpit SMTP port
		8025  // Mailpit web interface port
	],

	"portsAttributes": {
		"8025": {
			"label": "Mailpit UI",
			"onAutoForward": "silent"
		},
		"5432": {
			"label": "PostgreSQL",
			"onAutoForward": "silent"
		},
		"1025": {
			"label": "Mailpit SMTP",
			"onAutoForward": "silent"
		}
	},

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				// Javascript
				"bradlc.vscode-tailwindcss",
				"britesnow.vscode-toggle-quotes",
				"dbaeumer.vscode-eslint",
				"yoavbls.pretty-ts-errors",
				// General
				"esbenp.prettier-vscode",
				"aaron-bond.better-comments",
				"johnpapa.vscode-peacock",
				"editorconfig.editorconfig",
				"alefragnani.bookmarks",
				"formulahendry.code-runner",
				"streetsidesoftware.code-spell-checker",
				"streetsidesoftware.code-spell-checker-spanish",
				"usernamehw.errorlens",
				"kisstkondoros.vscode-gutter-preview",
				"oderwat.indent-rainbow",
				"quicktype.quicktype",
				"helixquar.randomeverything",
				"eamodio.gitlens",
				// Python
				"ms-python.python",
				"ms-python.debugpy",
				"ms-python.vscode-pylance",
				"ms-python.vscode-python-envs",
				"charliermarsh.ruff",
				"ms-python.mypy-type-checker",
				"njpwerner.autodocstring",
				"batisteo.vscode-django",
				"bibhasdn.django-snippets",
				"bigonesystems.django",
				"shamanu4.django-intellisense",
				"bibhasdn.django-html",
				"wholroyd.jinja",
				// Misc
				"Google.google-antigravity",
				"sst-dev.opencode"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "vscode"
}
